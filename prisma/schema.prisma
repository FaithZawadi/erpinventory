// Prisma schema — Phase 0 of the MongoDB → PostgreSQL migration.
// Covers the CORE slice (tenant + auth + inventory) so the pattern can be
// proven end-to-end before scaling to the remaining models. See
// docs/POSTGRES_MIGRATION_PLAN.md for the staged plan and
// docs/POSTGRES_SETUP.md for the runbook.
//
// Notes on translation choices:
//  - PKs are uuid; `legacyMongoId` preserves the Mongo _id so the ETL can
//    re-point references to the new uuid foreign keys.
//  - role/status/movementType/direction are kept as String (not Prisma enums)
//    to preserve the exact Mongo string values ("Finance Manager", etc.) with
//    zero value-mapping during ETL. Tighten to enums/CHECKs later if desired.
//  - Genuinely document-shaped sub-objects (inventory, costing, customFields)
//    are Json for now; promote the ones you query/aggregate on to child tables
//    as each module is hardened.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String   @id @default(uuid())
  legacyMongoId String?  @unique
  name          String
  plan          String   @default("free")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users      User[]
  categories Category[]
  products   Product[]
  movements  StockMovement[]
  invoices       Invoice[]
  quotes         Quote[]
  purchaseOrders PurchaseOrder[]
  bills          Bill[]
  accounts       Account[]
  journalEntries JournalEntry[]

  @@map("companies")
}

model User {
  id            String   @id @default(uuid())
  legacyMongoId String?  @unique
  name          String
  email         String   @unique
  password      String?
  role          String   @default("User")
  status        String   @default("Active")
  department    String?
  authProvider  String   @default("credentials")
  tokenVersion  Int      @default(0)
  avatar        String?
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@map("users")
}

model Category {
  id            String     @id @default(uuid())
  legacyMongoId String?    @unique
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  name          String
  description   String?
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  path          String     @default("")
  level         Int        @default(0)
  customFields  Json?
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  isDeleted     Boolean    @default(false)
  productCount  Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([companyId])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid())
  legacyMongoId String?  @unique
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  type          String   @default("Inventory Item")
  sku           String
  description   String?
  category      String?
  unit          String   @default("pcs")
  inventory     Json?
  costing       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements StockMovement[]

  @@index([companyId])
  @@index([companyId, sku])
  @@map("products")
}

model StockMovement {
  id             String   @id @default(uuid())
  legacyMongoId  String?  @unique
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  movementNumber String
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  movementType   String
  direction      String
  quantity       Float
  previousStock  Float
  newStock       Float
  costing        Json?
  createdAt      DateTime @default(now())

  @@index([companyId])
  @@index([productId])
  @@map("stock_movements")
}

// ── Phase 1: Sales ───────────────────────────────────────────────────────────
// Invoice/Quote line items become proper child tables (invoice_lines,
// quote_lines) with FKs — the relational win over embedded Mongo arrays.
// `raw` Json preserves any header fields not yet promoted to columns so the
// ETL is lossless while the slice is hardened.

model Invoice {
  id            String   @id @default(uuid())
  legacyMongoId String?  @unique
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  invoiceNumber String
  invoiceDate   DateTime?
  dueDate       DateTime?
  status        String   @default("draft")
  customerRef   String?
  customerName  String?
  customerEmail String?
  currency      String   @default("KES")
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  discountTotal Float    @default(0)
  total         Float    @default(0)
  amountPaid    Float    @default(0)
  balance       Float    @default(0)
  raw           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines InvoiceLine[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("invoices")
}

model InvoiceLine {
  id              String  @id @default(uuid())
  legacyKey       String? @unique
  invoiceId       String
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNumber      Int     @default(0)
  itemType        String  @default("product")
  productLegacyId String?
  description     String
  unit            String  @default("pcs")
  quantity        Float   @default(0)
  unitPrice       Float   @default(0)
  taxRate         Float   @default(16)
  taxAmount       Float   @default(0)
  discountAmount  Float   @default(0)
  lineTotal       Float   @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Quote {
  id            String   @id @default(uuid())
  legacyMongoId String?  @unique
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  quoteNumber   String
  quoteDate     DateTime?
  status        String   @default("draft")
  customerRef   String?
  customerName  String?
  customerEmail String?
  currency      String   @default("KES")
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  discountTotal Float    @default(0)
  total         Float    @default(0)
  raw           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines QuoteLine[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("quotes")
}

model QuoteLine {
  id              String  @id @default(uuid())
  legacyKey       String? @unique
  quoteId         String
  quote           Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  lineNumber      Int     @default(0)
  itemType        String  @default("product")
  productLegacyId String?
  description     String
  unit            String  @default("pcs")
  quantity        Float   @default(0)
  unitPrice       Float   @default(0)
  taxRate         Float   @default(16)
  taxAmount       Float   @default(0)
  discountAmount  Float   @default(0)
  lineTotal       Float   @default(0)

  @@index([quoteId])
  @@map("quote_lines")
}

// ── Phase 2: Purchases ───────────────────────────────────────────────────────
model PurchaseOrder {
  id                   String    @id @default(uuid())
  legacyMongoId        String?   @unique
  companyId            String
  company              Company   @relation(fields: [companyId], references: [id])
  poNumber             String
  poDate               DateTime?
  expectedDeliveryDate DateTime?
  status               String    @default("draft")
  supplierRef          String?
  supplierName         String?
  supplierEmail        String?
  currency             String    @default("KES")
  subtotal             Float     @default(0)
  taxTotal             Float     @default(0)
  total                Float     @default(0)
  raw                  Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lines PurchaseOrderLine[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  legacyKey       String?       @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNumber      Int           @default(0)
  productLegacyId String?
  description     String
  unit            String        @default("pcs")
  quantity        Float         @default(0)
  unitPrice       Float         @default(0)
  vatRate         Float         @default(0)
  vatAmount       Float         @default(0)
  lineTotal       Float         @default(0)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model Bill {
  id                    String    @id @default(uuid())
  legacyMongoId         String?   @unique
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  billNumber            String
  supplierInvoiceNumber String?
  billDate              DateTime?
  dueDate               DateTime?
  status                String    @default("draft")
  supplierRef           String?
  supplierName          String?
  supplierEmail         String?
  currency              String    @default("KES")
  subtotal              Float     @default(0)
  taxTotal              Float     @default(0)
  total                 Float     @default(0)
  amountPaid            Float     @default(0)
  balance               Float     @default(0)
  raw                   Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lines BillLine[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("bills")
}

model BillLine {
  id              String  @id @default(uuid())
  legacyKey       String? @unique
  billId          String
  bill            Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  lineNumber      Int     @default(0)
  productLegacyId String?
  description     String
  unit            String  @default("pcs")
  quantity        Float   @default(0)
  unitPrice       Float   @default(0)
  vatRate         Float   @default(0)
  vatAmount       Float   @default(0)
  lineTotal       Float   @default(0)

  @@index([billId])
  @@map("bill_lines")
}

// ── Phase 3: Finance (double-entry) ──────────────────────────────────────────
// Chart of accounts (self-referencing tree) + journal entries whose lines are a
// real child table. Each journal line carries debit/credit AND a genuine FK to
// the account it posts to — the integrity Mongo's embedded arrays couldn't
// enforce. accountLegacyId preserves the original Mongo ref so the FK can be
// resolved during ETL even if accounts migrate in a later pass.

model Account {
  id              String    @id @default(uuid())
  legacyMongoId   String?   @unique
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  accountCode     String
  accountName     String
  accountType     String
  subType         String?
  parentAccountId String?
  parentAccount   Account?  @relation("AccountTree", fields: [parentAccountId], references: [id])
  childAccounts   Account[] @relation("AccountTree")
  path            String    @default("")
  level           Int       @default(0)
  canPost         Boolean   @default(true)
  systemAccount   String?
  currency        String    @default("KES")
  cachedBalance   Float     @default(0)
  isActive        Boolean   @default(true)
  taxable         Boolean   @default(false)
  defaultTaxRate  Float     @default(0)
  bankDetails     Json?
  raw             Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  journalLines JournalLine[]

  @@unique([companyId, accountCode])
  @@index([companyId])
  @@index([companyId, accountType])
  @@map("accounts")
}

model JournalEntry {
  id                String    @id @default(uuid())
  legacyMongoId     String?   @unique
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  entryNumber       String
  entryDate         DateTime?
  entryType         String    @default("manual")
  description       String
  status            String    @default("draft")
  partyType         String?
  partyRef          String?
  dueDate           DateTime?
  amountPaid        Float     @default(0)
  amountOutstanding Float     @default(0)
  isFullyPaid       Boolean   @default(false)
  fiscalYear        Int?
  fiscalMonth       Int?
  raw               Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lines JournalLine[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id              String       @id @default(uuid())
  legacyKey       String?      @unique
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  lineNumber      Int          @default(0)
  accountLegacyId String?
  accountId       String?
  account         Account?     @relation(fields: [accountId], references: [id])
  accountType     String?
  debit           Float        @default(0)
  credit          Float        @default(0)
  description     String?

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}
